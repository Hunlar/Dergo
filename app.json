
{
  "name": "Misery Video Streamer",
  "description": "A Telegram bot for video streaming based on Pyrogram and pytgcalls.",
  "logo": "https://telegra.ph/file/657969315fbe1a90fbb84.jpg",
  "keywords": [
    "pytgcalls",
    "telegram bot",
    "video stream"
  ],
  "website": "https://t.me/XeBorn",
  "repository": "https://github.com/Hunlar/Dergo",
  "success_url": "https://t.me/TurdusMaximus",
  "env": {
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API HASH",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram bot token",
      "required": true
    },
    "BOT_USERNAME": {
      "description": "Bot username without @",
      "required": true
    },
    "ASSISTANT_NAME": {
      "description": "Assistant username without @",
      "required": true
    },
    "SESSION_NAME": {
      "description": "Pyrogram session string",
      "required": true
    },
    "SUDO_USERS": {
      "description": "Admin user IDs separated by spaces",
      "required": true
    },
    "DURATION_LIMIT": {
      "description": "Maximum video duration in minutes",
      "required": true
    }
  },
  "addons": [],
  "formation": {
    "worker": {
      "quantity": 1
    }
  },
  "stack": "container"
}
